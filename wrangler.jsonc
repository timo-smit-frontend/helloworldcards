{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "helloworldcards",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": true,
  // Dashboard login uses Worker secrets, not vars: DASHBOARD_USERNAME, DASHBOARD_PASSWORD, DASHBOARD_SESSION_SECRET
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // Only the media entrypoint is cached (see "exports"). Media keys never change — a
  // replaced image gets a new key — so the cache is kept across deploys instead of
  // starting cold every time the Worker is published.
  "cache": {
    "enabled": true,
    "cross_version_cache": true
  },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "CachedMedia": { "type": "worker", "cache": { "enabled": true } }
  },
  "routes": [
    { "pattern": "helloworldcards.com", "custom_domain": true },
    { "pattern": "www.helloworldcards.com", "custom_domain": true },
    { "pattern": "admin.helloworldcards.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helloworldcards",
      "database_id": "b4654223-cb42-4b31-b1d7-0acaf0ed6a4a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "helloworldcards-media"
    }
  ]
}
