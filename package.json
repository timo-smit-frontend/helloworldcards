{
  "name": "helloworldcards",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "if [ \"${WORKERS_CI:-}\" = 1 ] && [ \"${WORKERS_CI_BRANCH:-}\" = main ]; then npm run migrate:remote; fi",
    "cms:pull": "npx vite-node scripts/cms-sync.mts --pull",
    "cms:pull:remote": "npx vite-node scripts/cms-sync.mts --pull --remote",
    "cms:push": "npx vite-node scripts/cms-sync.mts",
    "cms:push:remote": "npx vite-node scripts/cms-sync.mts --remote",
    "cms:status": "npx vite-node scripts/cms-sync.mts --dry-run",
    "cms:status:remote": "npx vite-node scripts/cms-sync.mts --remote --dry-run",
    "cms:seed-media": "npx vite-node scripts/generate-seed-media.mts",
    "media:sync": "npx vite-node scripts/cms-sync.mts --media",
    "media:sync:remote": "npx vite-node scripts/cms-sync.mts --media --remote",
    "media:backfill": "vite-node scripts/backfill-media-variants.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "migrate:remote": "wrangler d1 migrations apply helloworldcards --remote",
    "deploy": "npm run build && npm run migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide": "^1.31.0",
    "morphicons": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.0",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.0",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.128.0",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
