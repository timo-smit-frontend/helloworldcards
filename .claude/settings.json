{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/listing-publish-check.mjs 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/listing-publish-check.mjs 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
